# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build / output
# ---------------------------------------------------------------------------
/.next/
/out/
/build
/dist
/coverage
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# SECRETS & ENVIRONMENT  — never commit these
# ---------------------------------------------------------------------------
# All env files (local overrides, per-environment configs)
.env
.env.*
!.env.example
!.env.*.example
*.local

# Keys, certificates, credentials
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
*.der
id_rsa*
*.keystore
*.jks

# Cloud / service credentials
**/serviceAccount*.json
**/service-account*.json
*credentials*.json
*secret*.json
gcp-*.json
aws.json
.aws/
.npmrc
.netrc

# Supabase — entire folder stays local (public repo; schema/RLS details are
# applied remotely via migrations and documented in supabase/SCHEMA.md)
/supabase/

# ---------------------------------------------------------------------------
# Logs & debug
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log
logs/

# ---------------------------------------------------------------------------
# Deploy / tooling
# ---------------------------------------------------------------------------
.vercel
.turbo

# ---------------------------------------------------------------------------
# Private / internal docs — keep out of the repo
# ---------------------------------------------------------------------------
CARSVILLA_WEB_PIPELINE.md
/private/
*.private.md

# ---------------------------------------------------------------------------
# Editor / OS junk
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# -----------------------------------------------------------------------------
# CarsVilla — environment variables template
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# -----------------------------------------------------------------------------

# Public site URL (used for SEO canonicals, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://carsvilla.org

# --- Supabase (Phase 3 — lead forms write here; RLS is the security boundary) ---
# Both NEXT_PUBLIC_* values are public by design (publishable/anon key).
# They are inlined at BUILD time — must also be set in the CI deploy environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser, never import in src/
SUPABASE_SERVICE_ROLE_KEY=

# --- Vehicle / RC lookup API (Phase 3, currently mocked) ---
# e.g. Surepass / APISetu / Signzy
RTO_API_BASE_URL=
RTO_API_KEY=

# --- Optional integrations (later) ---
# Payment / lead notifications / analytics
RESEND_API_KEY=
NEXT_PUBLIC_GA_ID=

# -----------------------------------------------------------------------------
# CarsVilla — environment variables template
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# -----------------------------------------------------------------------------

# Public site URL (used for SEO canonicals, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://carsvilla.example.com

# --- Supabase (added in Phase 2, not used in the demo) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Vehicle / RC lookup API (Phase 3, currently mocked) ---
# e.g. Surepass / APISetu / Signzy
RTO_API_BASE_URL=
RTO_API_KEY=

# --- Optional integrations (later) ---
# Payment / lead notifications / analytics
RESEND_API_KEY=
NEXT_PUBLIC_GA_ID=
